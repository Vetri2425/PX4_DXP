# Build artifacts
build/
install/
log/
__pycache__/
*.pyc

# rosbags
*.bag
*.db3
*.mcap
bags/
baseline/**/bag/

# IDE
.vscode/
.idea/
*.swp

# Local env / secrets (never commit credentials)
.env
*.local
secrets/
config/*.env
config/rover_password.json
config/rover_machine_tokens.json
config/bag_autorecord.token
config/*.token

# OS
.DS_Store
Thumbs.db

# Claude Code local state
.claude/

# Frontend verification app (not the real GCS app)
front-end/

# Node / frontend build artifacts
node_modules/
.expo/
dist/
*.tsbuildinfo

# Android / iOS native build outputs (Capacitor / RN / Expo)
android/
ios/

# Task planning docs (local scratch, not for tracking)
task_frontend/
task_rpp_upgrade/
docs/Task_SRC/
docs/Task_server/

# Local analysis and scratch tools (not for tracking)
docs/Analysis/
tools/scp_tool.md

# Misc
nul
.grok/

# Mac dev-flow virtualenv (no-hardware testing — see docs/SESSION_STARTUP_MAC_NO_HARDWARE.md)
.venv-dev/

# Built frontend bundle — 21MB artifact, not version-controlled (deploy separately)
front-end.zip

# Uploaded mission files (runtime user data). Committed templates are negated below.
# Case classes, not *.dxf: CAD tools emit .DXF as often as .dxf, and gitignore
# matching is case-sensitive — a plain *.dxf leaves every uppercase upload
# untracked-but-not-ignored, which is what buried real changes in git status.
server/missions/*.[dD][xX][fF]
server/missions/*.[cC][sS][vV]
!server/missions/soccer_field_penalty_area.dxf

# Staged aligned-DXF missions (runtime handoff artifacts)
server/missions/staging/

# Local scratch notes / planning (not for tracking)
Todos/
Role_of_Path_engine.md
Server-rpp.md

# API testing local config
.postman.json
.kiro/

# GCS-imported params (dated subdirs — local reference only, not tracked)
params/*/
params/TANK_PARM/
params/old/

# GCS-imported firmware builds (local reference only, not tracked)
firmware/

# GCS analysis scripts (local reference only, not tracked)
tools/analysis/
*.bak

# Local hardware / encoder experiments (not for tracking)
Encoder_Fix/

# GCS-imported PX4 params by date (local reference only)
PX4_params/

# DXF demo files (local scratch, not for tracking)
Simple Demo/

# Architecture and TODO scratch docs (local planning only)
docs/Architecture/
docs/TODO/

# Field analysis images (local reference only)
image_ref/

# Rosbag topic lists (local scratch)
tools/rosbag.txt

# Generated DXF/CSV sidecars (entities/extensions/linecfg cache, regenerated on parse)
server/missions/.*.[dD][xX][fF].*.json
server/missions/.*.[cC][sS][vV].*.json

# Local bag/trajectory analysis output (data + plots, not for tracking)
analysis/

# Auto-recorder bundles (bag + manifest + analysis) — data, never tracked.
# Note: config/rosbag_qos_overrides.yaml IS tracked (it is recorder config).
bags_jet/
**/analysis.json
**/analyze.log
Simple Demo/sample_dxf/videos/

# DXF verification harness generated artifacts (PNGs, MP4s, summaries)
verification_output/

# Local dev server log (uvicorn run from server/ on the Mac) — never tracked.
server/_local_server.log

