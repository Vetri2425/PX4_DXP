front-end.zip

# Uploaded mission files (runtime user data). Committed templates are negated below.
# Case classes, not *.dxf: CAD tools emit .DXF as often as .dxf, and gitignore
# matching is case-sensitive — a plain *.dxf leaves every uppercase upload
# untracked-but-not-ignored, which is what buried real changes in git status.
server/missions/*.[dD][xX][fF]
server/missions/*.[cC][sS][vV]
!server/missions/soccer_field_penalty_area.dxf

# Staged aligned-DXF missions (runtime handoff artifacts)
server/missions/staging/

# Local scratch notes / planning (not for tracking)
Todos/
Role_of_Path_engine.md
Server-rpp.md

# API testing local config
.postman.json
.kiro/

# GCS-imported params (dated subdirs — local reference only, not tracked)
params/*/
params/TANK_PARM/
params/old/

# GCS-imported firmware builds (local reference only, not tracked)
firmware/

