# Legacy/bootstrap format. New deployments should normally add named profiles
# from the authenticated tablet RTK settings page. To migrate an older rover,
# copy this file to config/ntrip.env and restrict it to the rover user:
#   cp config/ntrip.env.example config/ntrip.env
#   chmod 600 config/ntrip.env
# Never commit config/ntrip.env; it is ignored by git.
NTRIP_HOST=caster.example.com
NTRIP_PORT=2101
NTRIP_MOUNTPT=YOUR_MOUNTPOINT
NTRIP_USER=YOUR_USERNAME
NTRIP_PASS=YOUR_PASSWORD
