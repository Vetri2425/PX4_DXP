[Unit]
Description=Drawing Rover FastAPI Server (REST + Socket.IO + ROS2 bridge)
After=rpp-pipeline.service
Wants=rpp-pipeline.service
# Server can survive RPP restart (reconnects via TRANSIENT_LOCAL topics),
# so we do NOT use PartOf here. Only stop the server explicitly.

[Service]
# S1 — systemd watchdog. HARD DEPENDENCY: `python3 -c "import sdnotify"` MUST
# succeed for the service user, or main.py's _sd_notifier is None (main.py:60-66),
# READY=1 is never sent, systemd kills the unit at TimeoutStartSec, and
# StartLimitBurst=10 takes rover-server DOWN PERMANENTLY after ~10 attempts.
# That exact failure happened on 2026-07-29 — the unit sat in `activating` while
# /api/ping answered fine, because the lifespan reached yield but the notify
# no-op'd.
#
# Install it from APT, never pip: `sudo apt install python3-sdnotify` (0.3.1-2,
# zero dependencies, lands in /usr/lib/python3/dist-packages so it is readable
# under ProtectSystem=strict). pip cannot build the 0.3.2 sdist on this Jetson —
# setuptools 80.9.0 in ~/.local shadows the system one and calls
# canonicalize_version(strip_trailing_zero=...) which apt's packaging 21.3 lacks.
# That breaks EVERY sdist install on the box, not just this one.
#
# Verify after any OS reimage or python change:
#   sudo -u flash python3 -c "import sdnotify"    # must exit 0
Type=notify
User=flash
Group=flash
WorkingDirectory=/home/flash/PX4_DXP/server
# NOTE: rover-server is intentionally NOT gated on /mavros discovery. It is the
# operator's UI/telemetry surface and must come up even when MAVROS is down so
# /api/mission/status can report fcu_connected:False (graceful degradation).
# Upholds= (from px4-dxp) + Restart= reconnect once MAVROS returns.
# READY=1 is sent by main.py once ROS init / node / executor / beacon are up.
# WATCHDOG=1 comes from the SAFETY task, not the telemetry loop (S2) — the
# process state worth protecting is the E-stop path. It is emitted every ~3 s
# ABOVE the `ros_node is None` guard (S1-a), so a failed rclpy init still feeds
# the watchdog instead of boot-looping a deliberately degraded server.
# WatchdogSec=15 gives 5 beats of margin; estop_async can block the safety task
# ~10 s worst case (two 5 s service timeouts), which fits inside that.
ExecStart=/home/flash/PX4_DXP/server/run.sh
Restart=on-failure
RestartSec=5
StartLimitInterval=300
StartLimitBurst=10
WatchdogSec=15

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/flash/.ros /home/flash/PX4_DXP /tmp /var/tmp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=no

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=2G
CPUQuota=200%

# Environment
Environment=ROS_DOMAIN_ID=0
Environment=ROS_LOCALHOST_ONLY=0
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/home/flash/PX4_DXP/config/fastdds_no_shm.xml
Environment=HOME=/home/flash
Environment=FASTAPI_PORT=5001
Environment=ROVER_TOKEN_FILE=/home/flash/PX4_DXP/config/rover_token
# S3 CLOSED 2026-07-29 — operator auth is ENFORCED. The old
# `Environment=ROVER_DISABLE_AUTH=1` line lived here since dev bring-up and was
# removed after the Jul-11 operator password was confirmed usable.
#
# Two names disable auth and BOTH must stay absent (config.py:203-207):
# ROVER_DISABLE_AUTH and ROVER_AUTH_DISABLED. The latter also had a Jetson-only
# drop-in (50-auth-disabled.conf) that was removed the same day — deleting one
# and not the other silently leaves auth OFF while login still rejects bad
# passwords, which reads exactly like a working gate. Verified by an
# unauthenticated LAN request to /api/mission/status returning 401, not 200.
#
# Disabling auth also forces a loopback bind (run.sh:16, config.py:309); the
# 20-host.conf drop-in overrides that to 0.0.0.0, so auth-off here means
# unauthenticated AND LAN-reachable. Do not re-add either name.

# Output
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rover-server

# Shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=60
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
