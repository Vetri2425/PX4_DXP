[Unit]
Description=Drawing Rover FastAPI Server (REST + Socket.IO + ROS2 bridge)
After=rpp-pipeline.service
Wants=rpp-pipeline.service
# Server can survive RPP restart (reconnects via TRANSIENT_LOCAL topics),
# so we do NOT use PartOf here. Only stop the server explicitly.

[Service]
# S1 BLOCKED 2026-07-29 — reverted to simple after a live deploy attempt.
# Type=notify + WatchdogSec=15 was installed on the Jetson and the unit never
# left `activating`: /api/ping answered (so the lifespan reached yield) but
# WatchdogTimestamp stayed n/a, i.e. main.py's _sd_notifier was None. Cause:
# `sdnotify` is pinned at server/requirements.txt:9 but is NOT installed on the
# Jetson — the server runs on system python3 with no venv. Installing it fails:
# the 0.3.2 sdist trips a setuptools/packaging incompatibility on that host
# (canonicalize_version() got an unexpected keyword 'strip_trailing_zero'), and
# fixing that pair risks ROS2's own python stack.
# DO NOT re-enable Type=notify until `python3 -c "import sdnotify"` succeeds on
# the Jetson. Without it systemd kills the unit every TimeoutStartSec and
# StartLimitBurst=10 takes rover-server DOWN PERMANENTLY after ~10 attempts.
# The main.py side (S1-a: heartbeat above the ros_node-None guard) is correct
# and harmless under Type=simple — leave it in place.
Type=simple
User=flash
Group=flash
WorkingDirectory=/home/flash/PX4_DXP/server
# NOTE: rover-server is intentionally NOT gated on /mavros discovery. It is the
# operator's UI/telemetry surface and must come up even when MAVROS is down so
# /api/mission/status can report fcu_connected:False (graceful degradation).
# Upholds= (from px4-dxp) + Restart= reconnect once MAVROS returns.
# When Type=notify is restored: READY=1 is sent by main.py after ROS init /
# node / executor / beacon, and WATCHDOG=1 comes from the SAFETY task (S2 moved
# it there — the process state worth protecting is the E-stop path, not the
# telemetry push). Add WatchdogSec=15 back at the same time, not before.
ExecStart=/home/flash/PX4_DXP/server/run.sh
Restart=on-failure
RestartSec=5
StartLimitInterval=300
StartLimitBurst=10

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/flash/.ros /home/flash/PX4_DXP /tmp /var/tmp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=no

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=2G
CPUQuota=200%

# Environment
Environment=ROS_DOMAIN_ID=0
Environment=ROS_LOCALHOST_ONLY=0
Environment=FASTRTPS_DEFAULT_PROFILES_FILE=/home/flash/PX4_DXP/config/fastdds_no_shm.xml
Environment=HOME=/home/flash
Environment=FASTAPI_PORT=5001
Environment=ROVER_TOKEN_FILE=/home/flash/PX4_DXP/config/rover_token
# S3 CLOSED 2026-07-29 — operator auth is ENFORCED. The old
# `Environment=ROVER_DISABLE_AUTH=1` line lived here since dev bring-up and was
# removed after the Jul-11 operator password was confirmed usable.
#
# Two names disable auth and BOTH must stay absent (config.py:203-207):
# ROVER_DISABLE_AUTH and ROVER_AUTH_DISABLED. The latter also had a Jetson-only
# drop-in (50-auth-disabled.conf) that was removed the same day — deleting one
# and not the other silently leaves auth OFF while login still rejects bad
# passwords, which reads exactly like a working gate. Verified by an
# unauthenticated LAN request to /api/mission/status returning 401, not 200.
#
# Disabling auth also forces a loopback bind (run.sh:16, config.py:309); the
# 20-host.conf drop-in overrides that to 0.0.0.0, so auth-off here means
# unauthenticated AND LAN-reachable. Do not re-add either name.

# Output
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rover-server

# Shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=60
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
